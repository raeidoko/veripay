# Dots3 through OpenRouter; missing keys and failed requests use built-in rules.
# Use AI_PROVIDER=rules to disable external requests.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="dots-studio/dots-3-note-preview:free"
# For direct Claude access, set AI_PROVIDER=anthropic and set both values below.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Optional password override for all seeded local demo accounts.
# Development uses the local default when empty. Production requires a private
# value of at least 10 characters to enable seeded sign-in.
VERIPAY_DEMO_PASSWORD=""

# Local backend (Node.js 24+). Paths default to data/governance/.
PORT=3001
# Public website origin when a reverse proxy changes the Host header.
# VERIPAY_PUBLIC_ORIGIN="https://veripay.example.com"
# VERIPAY_ADMIN_DATA_DIR="data/governance"
# VERIPAY_DB_PATH="data/governance/veripay.sqlite"
# VERIPAY_UPLOAD_DIR="data/uploads/products"

# Simulated funds only. Setting false disables top-ups and new payments;
# a real payment provider has not been integrated.
VERIPAY_SANDBOX_PAYMENTS=true
